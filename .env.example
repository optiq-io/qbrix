# qbrix self-host configuration, read by docker-compose.yml.
# bin/selfhost-init copies this file to .env and fills in the secrets.

# --- release ---
QBRIX_VERSION=latest
# QBRIX_REGISTRY=ghcr.io/optiq-io

# --- network ---
# the console and the api (/api) are both served on this port
QBRIX_PORT=8000
# public url of the console, used in verify / reset / invite links
CONSOLE_URL=http://localhost:8000
# extra browser origins allowed to call the api with credentials, comma separated
# CORS_ORIGINS=
# reverse proxies in front of the api, counting the bundled gateway. raise it to
# 2 when a load balancer or tls terminator forwards to QBRIX_PORT and appends to
# x-forwarded-for, so login rate limits key on each client, not on that hop.
# TRUSTED_PROXY_HOPS=1

# --- secrets (required) ---
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
TOKEN_SECRET=

# --- signup ---
#   first-user  — the first registration creates the workspace and its admin,
#                 then public registration closes; invite teammates from the console
#   invite-only — public registration is always closed
#   open        — anyone may create a workspace
SIGNUP_MODE=first-user

# --- email (optional) ---
# with no provider new accounts are verified automatically and reset / invite
# links are written to the proxy log (docker compose logs proxy).
# auto picks resend when RESEND_API_KEY is set, else smtp when SMTP_HOST is.
EMAIL_PROVIDER=auto
# EMAIL_FROM=qbrix <noreply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# RESEND_API_KEY=

# --- analytics (optional) ---
# insights and the event log. adds the trace service and clickhouse.
# COMPOSE_PROFILES=analytics
# ANALYTICS_ENABLED=true

# --- logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
