# qbrix contributor environment: `make dev` and docker-compose.dev.yml
# copy to .env. for a self-hosted install use .env.example (bin/selfhost-init).

# --- infrastructure ---
POSTGRES_HOST=postgres
POSTGRES_USER=qbrix
POSTGRES_PASSWORD=qbrix
POSTGRES_DATABASE=qbrix
REDIS_HOST=redis

# --- runtime environment ---
# "dev" enables auth bypass and seeds a dev user (local development only)
# set to "prod" (or any non-"dev" value) for production deployments
RUNENV=dev

# --- auth ---
# IMPORTANT: change both secrets in production — proxysvc will refuse to start
# if either is left as the default when RUNENV != "dev"
JWT_SECRET_KEY=change-me-in-production
TOKEN_SECRET=change-me-in-production

# --- logging ---
LOG_LEVEL=WARNING
LOG_FORMAT=json

# --- error tracking (optional) ---
# one sentry project per service, so each dsn is named per service rather than
# a single SENTRY_DSN: `make dev` exports this whole file into every service
# process, and a shared var would file all of them under one project.
# leave unset to disable (sentry is a no-op without a dsn).
SENTRY_ENVIRONMENT=local
# PROXY_SENTRY_DSN=
# MOTOR_SENTRY_DSN=
# CORTEX_SENTRY_DSN=
# TRACE_SENTRY_DSN=
# METER_SENTRY_DSN=

# --- cloud edition (optional) ---
# plan tiers, quotas and billing. docker compose reads QBRIX_EE_ENABLED;
# `make dev` runs the proxy directly, which reads PROXY_EE_ENABLED.
# QBRIX_EE_ENABLED=false
# PROXY_EE_ENABLED=true
# CLICKHOUSE_HOST=clickhouse
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# base license price per tier (5-tier usage model)
# STRIPE_PRICE_ID_STARTER=
# STRIPE_PRICE_ID_GROWTH=
# STRIPE_PRICE_ID_SCALE=
# STRIPE_PRICE_ID_ENTERPRISE=
# usage/overage: one selections meter + a metered price per self-serve tier
# STRIPE_METER_ID=
# STRIPE_METERED_PRICE_ID_STARTER=
# STRIPE_METERED_PRICE_ID_GROWTH=
# STRIPE_METERED_PRICE_ID_SCALE=

# --- self-host runtime ---
# who may create a workspace through public registration:
#   first-user  — the first registration creates the workspace and its admin,
#                 and public registration closes after it (default)
#   open        — anyone may create a workspace (what qbrix cloud runs)
#   invite-only — public registration is always closed
SIGNUP_MODE=first-user
# public url of the console, used in verify / reset / invite links
CONSOLE_URL=http://localhost:3001
# extra browser origins for the credentialed console cors policy, comma
# separated. localhost is always allowed.
# CORS_ORIGINS=https://qbrix.example.com

# --- transactional email (optional) ---
# auto picks resend when RESEND_API_KEY is set, else smtp when SMTP_HOST is,
# else none. with no provider new accounts are auto-verified and reset/invite
# links are written to the proxy log.
EMAIL_PROVIDER=auto
# EMAIL_FROM=qbrix <noreply@localhost>
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
